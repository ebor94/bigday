# .htaccess de la encuesta October Big Day — AppServ (Apache 2.2 en Windows).
# Solo directivas de Apache 2.2 (sin Require/Order 2.4). Todo lo que depende de un módulo va dentro de
# <IfModule>: si el módulo no está cargado, la directiva se ignora y el sitio sigue funcionando.
# Requiere AllowOverride con FileInfo, Indexes, Options y Limit (o All) para www/bigDay-encuesta.

# Sin listado de directorios y página de entrada.
Options -Indexes
DirectoryIndex index.html

# www → sin www (301), conservando la ruta y la query (?src=…). La API solo admite por CORS el origen
# https://losolivoscucuta.com: desde https://www.losolivoscucuta.com todo envío fallaría.
# En un .htaccess la ruta que ve RewriteRule es relativa a este directorio (sin "/bigDay-encuesta/"),
# por eso se antepone en el destino. La query se conserva sola (el destino no lleva "?").
# mod_rewrite en .htaccess exige FollowSymLinks (o SymLinksIfOwnerMatch): se activa aquí, dentro del
# IfModule, para no depender del httpd.conf. Sin mod_rewrite el bloque se ignora (sin 500).
<IfModule mod_rewrite.c>
  Options +FollowSymLinks
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.losolivoscucuta\.com$ [NC]
  RewriteRule ^(.*)$ https://losolivoscucuta.com/bigDay-encuesta/$1 [R=301,L]
</IfModule>

# Tipos MIME (mod_mime, incluido en el núcleo de AppServ).
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType font/woff2 .woff2
  AddDefaultCharset UTF-8
</IfModule>

# Compresión (mod_deflate).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Navegadores muy viejos con fallos de gzip.
  <IfModule mod_setenvif.c>
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  </IfModule>
</IfModule>

# Caché. Todo JS/CSS (y fuentes) de dist está en assets/ con hash en el nombre, así que mod_expires
# mismo les da un año: el resultado es correcto gane mod_expires o mod_headers (en Apache 2.2 el
# orden entre ambos no está garantizado). index.html se excluye de forma explícita: siempre se revalida.
# Las imágenes de img/ no llevan hash: un día.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  <FilesMatch "^index\.html$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # index.html (también al pedir /bigDay-encuesta/): sin caché, así un despliegue nuevo se ve de inmediato.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Cabeceras de seguridad.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Assets con hash (assets/*.js, *.css): caché de un año e inmutable.
# En Apache 2.2 no hay <If>; se usa SetEnvIf sobre la URI y Header ... env=.
<IfModule mod_setenvif.c>
  <IfModule mod_headers.c>
    SetEnvIf Request_URI "/assets/[^/]+\.(js|css|woff2?|svg|webp|png)$" ES_ASSET_HASH
    Header set Cache-Control "public, max-age=31536000, immutable" env=ES_ASSET_HASH
  </IfModule>
</IfModule>
