{
  "name": "encuesta-october-bigday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Encuesta de experiencia del 2.º October Big Day (Parque de Vida Los Olivos, Serfunorte)",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
